{
  "manifest_version": 3,
  "name": "ScreenTinker stream picture",
  "version": "1.0",
  "description": "Lets the stream renderer (server/lib/stream-out.js) hand its own picture to screens. Loaded only into the browser the server itself runs; never installed anywhere else.",
  "key": "",
  "permissions": ["tabCapture", "tabs"],
  "background": { "service_worker": "sw.js" }
}
