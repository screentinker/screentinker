{
  "name": "screentinker",
  "version": "3.0.3",
  "license": "MIT",
  "description": "ScreenTinker - Digital Signage Management Server",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "build:legacy-player": "node scripts/build-legacy-player.js",
    "build:certified-hardware": "node scripts/build-certified-hardware.js",
    "test": "node --test --test-concurrency=2",
    "smoke": "node smoke-ui.js"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@azure/msal-node": "^7.1.1",
    "@azure/storage-blob": "^12.34.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@node-saml/node-saml": "^5.1.0",
    "@simplewebauthn/server": "14.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "stripe": "^23.0.1",
    "unzipper": "^0.12.5",
    "uuid": "^14.0.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.3",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "js-yaml": "^5.5.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.3"
    }
  }
}
