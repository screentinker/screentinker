<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="launchArgs" type="assocarray" onChange="onLaunchArgs" />
    <!-- set when the viewer leaves from a screen with nothing behind it; main.brs closes the app -->
    <field id="exitRequested" type="boolean" value="false" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/device.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/tz.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/powerwindow.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/queuechime.brs" />
  <script type="text/brightscript" uri="MainScene.brs" />
  <children>
    <Rectangle id="backdrop" width="1920" height="1080" color="0x000000FF" />
    <Group id="stage" />
    <PairingView id="pairing" visible="false" />
    <Rectangle id="blackout" width="1920" height="1080" color="0x000000FF" visible="false" />
    <Overlay id="overlay" visible="false" />
    <Timer id="heartbeat" repeat="true" duration="15" />
    <Timer id="reregister" repeat="true" duration="600" />
    <Timer id="powerTick" repeat="true" duration="30" />
    <Timer id="launchTimer" repeat="false" duration="5" />
    <!-- The "Now serving" chime (source/lib/queuechime.brs): two short tones, ~0.9 s, never looped.
         Generated by roku/tools/make-queue-chime.js. -->
    <SoundEffect id="queueChimeSound" uri="pkg:/sounds/queue-chime.wav" />
  </children>
</component>
